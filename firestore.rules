rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if user is owner of resource (by ID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check ownership via a field in the document.
    // Covers every primary-owner field used across collections:
    //   • authorId  — posts, jobs, questions, university posts, comments
    //   • hostId    — meetups
    //   • sellerId  — marketplace (THIS was missing → marketplace delete
    //                 always returned permission-denied for the seller)
    //   • userId    — notifications, subcollections under /users/{uid}/…
    //   • deletedBy — tombstones in deleted_posts
    function isDocumentOwner(data) {
      return isAuthenticated() && (
        data.authorId == request.auth.uid ||
        data.hostId == request.auth.uid ||
        data.sellerId == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.senderId == request.auth.uid ||
        data.deletedBy == request.auth.uid
      );
    }

    // Helper to check if user is admin
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isAuthenticated() && 
        (userDoc.data.role == 'admin' || userDoc.data.isAdmin == true || userDoc.data.isAdmin == 'true');
    }

    // Helper to check if a field is not being changed
    function isUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Helper to check if user has verified their phone number
    function isPhoneVerified() {
      return isAuthenticated() && request.auth.token.phone_number != null;
    }

    // ==========================================================
    // NOTICES
    // ==========================================================
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================================
    // PUBLIC COLLECTIONS (Global Feed)
    // ==========================================================

    // Posts: Public Read, Owner Write + Public Like/Report
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'scrappedBy', 'scrapCount', 'shareCount', 'comments'])
      ) || (
        // reportCount: allow only +1 increment (prevents arbitrary manipulation)
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
        request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
      );
      // Allow delete by owner, admin, or automatically if reported enough (client-side mod logic)
      allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
        isAuthenticated() && resource.data.get('reportCount', 0) >= 5
      );
      
      // Post Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'reactions'])
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin();
      }
    }
    
    // Meetups: Public Read, Owner Write + Public Join/Like/Report
    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if isPhoneVerified() && request.resource.data.hostId == request.auth.uid;
      allow update: if (isDocumentOwner(resource.data) && isUnchanged('hostId')) ||
        // Allow host to transfer ownership when leaving (hostId + participantIds change together)
        (isDocumentOwner(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'hostId'])) ||
        isAdmin() || (
        // Joining/leaving meetups requires phone verification
        isPhoneVerified() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantIds', 'pendingParticipantIds',
          'hostName', 'hostAvatar'
        ])
      ) || (
        // Likes/scraps/comments don't require phone verification
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy', 'scrappedBy', 'comments'
        ])
      ) || (
        // reportCount: allow only +1 increment
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
        request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
      );
      allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
        isAuthenticated() && resource.data.get('reportCount', 0) >= 5
      );
      
      // Meetup Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin();
      }
    }
    
    // Jobs: Public Read, Owner Write + Public Like/Report
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'scrappedBy'])
      ) || (
        // reportCount: allow only +1 increment
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
        request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
      );
      allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
        isAuthenticated() && resource.data.get('reportCount', 0) >= 5
      );
    }
    
    // Marketplace: Public Read, Owner Write + Public Like/Report
    match /marketplace/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if (isDocumentOwner(resource.data) && isUnchanged('sellerId') && isUnchanged('authorId')) || isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'scrappedBy', 'isSold'])
      ) || (
        // reportCount: allow only +1 increment
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
        request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
      );
      allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
        isAuthenticated() && resource.data.get('reportCount', 0) >= 5
      );
    }

    // Job Applications: Users can create their own, read their own or if they're the employer
    match /job_applications/{applicationId} {
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.applicantId == request.auth.uid ||
        resource.data.employerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }
    
    // Questions (QnA): Public Read, Owner Write + Public Like/Report
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'scrappedBy', 'comments'])
      ) || (
        // reportCount: allow only +1 increment
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
        request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
      );
      allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
        isAuthenticated() && resource.data.get('reportCount', 0) >= 5
      );
      
      // Answers
      match /answers/{answerId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin();
      }
    }

    // ==========================================================
    // UNIVERSITY BOARDS
    // ==========================================================

    match /universities/{uniId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'scrappedBy', 'scrapCount', 'shareCount', 'comments'])
        ) || (
          // reportCount: allow only +1 increment
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
          request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
          isAuthenticated() && resource.data.get('reportCount', 0) >= 4
        );
        
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
          allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
            isAuthenticated() && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          );
          allow delete: if isDocumentOwner(resource.data) || isAdmin();
        }
      }
      
      match /questions/{questionId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answersCount', 'likes', 'likedBy', 'scrappedBy', 'scrapCount', 'shareCount', 'comments'])
        ) || (
          // reportCount: allow only +1 increment
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
          request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin() || (
          isAuthenticated() && resource.data.get('reportCount', 0) >= 4
        );
        
        match /answers/{answerId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
          allow update: if (isDocumentOwner(resource.data) && isUnchanged('authorId')) || isAdmin() || (
            isAuthenticated() && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          );
          allow delete: if isDocumentOwner(resource.data) || isAdmin();
        }
      }
    }

    // ==========================================================
    // USER DATA
    // ==========================================================
    
    match /users/{userId} {
      // Profiles are readable by authenticated users
      allow read: if isAuthenticated(); 
      
      allow create: if isOwner(userId) && 
                      (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
                      (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || request.resource.data.isAdmin == 'false');
      allow delete: if isOwner(userId) || isAdmin();
      
      // A user can fully update their own profile EXCEPT role and isAdmin
      // OR another user can ONLY update specific social fields
      allow update: if (isOwner(userId) && isUnchanged('role') && isUnchanged('isAdmin')) || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'following', 'blockedBy'])
      ) || isAdmin();
      
      // Notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated(); 
        allow update, delete: if isOwner(userId);
      }
    }

    // ==========================================================
    // PRIVATE / CHAT
    // ==========================================================

    match /conversations/{conversationId} {
      // Only participants can read/write
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds || 
        isAdmin() ||
        // Allow meetup participants to join the associated group chat
        // (user was added to meetup participantIds first, then needs to update the conversation)
        ('meetupId' in resource.data && 
         request.auth.uid in get(/databases/$(database)/documents/meetups/$(resource.data.meetupId)).data.participantIds)
      );
      // Allow deletion by admin OR by a participant of a meetup-linked
      // group chat (the host triggers this when they delete the meetup).
      // 1:1 conversations (no meetupId) remain admin-only on purpose.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        'meetupId' in resource.data &&
        request.auth.uid in resource.data.participantIds
      );

      match /messages/{messageId} {
        // Only participants of the parent conversation can read/write messages
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if isDocumentOwner(resource.data) || isAdmin() || (
          isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        );
        allow delete: if isDocumentOwner(resource.data) || isAdmin();
      }
    }

    // ==========================================================
    // DELETED / REPORTED CONTENT
    // ==========================================================
    
    match /deleted_users/{userId} {
      allow create, update: if isOwner(userId);
      allow read, delete: if isAdmin();
    }

    match /deleted_posts/{postId} {
      allow create, update: if isDocumentOwner(request.resource.data);
      allow read, delete: if isAdmin();
    }

    // Author-written tombstone created by deletePost() before hard-deleting
    // the original. Without this block client writes here silently fail
    // and the user sees "permission denied" on every main-feed post
    // delete. Mirrors deleted_posts.
    match /admin_deleted_posts/{postId} {
      allow create, update: if isDocumentOwner(request.resource.data);
      allow read, delete: if isAdmin();
    }

    match /admin_restricted_posts/{postId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    match /user_restrictions/{restrictionId} {
      allow create: if isAuthenticated();
      allow read: if resource == null || isDocumentOwner(resource.data) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admin_reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.reportedBy == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /admin_contact_inquiries/{inquiryId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================
    // COLLECTION GROUP SUPPORT
    // ==========================================================
    // collectionGroup('posts') queries need read access across all
    // paths named 'posts'. The rules above already cover /posts/{id}
    // and /universities/{uniId}/posts/{id}, but the catch-all below
    // would block any path the evaluator checks speculatively.
    // This wildcard ensures collectionGroup reads are allowed for
    // 'posts' under any parent.
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    // ==========================================================
    // DEFAULT CATCH-ALL
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
